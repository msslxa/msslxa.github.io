    <title>curriculumvitae</title>
    <!-- TemplateEndEditable -->
    <!-- TemplateBeginEditable name="head" -->
    <!-- TemplateEndEditable -->
    <style type="text/css">
		
		html {
  overflow-y: scroll; /* Forza la barra di scorrimento sempre visibile */
}

body {
  margin: 0;
  padding: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, -system-ui, sans-serif;
  font-size: 15px;
  line-height: 1.6;
  background-color: #f3f4f6;
  color: #111827;
  text-align: center;
}

/* Layout wrapper */
.thrColElsHdr #container {
  width: 100%;
  max-width: 1400px;
  margin: 16px auto 24px;
  background: #ffffff;
  border-radius: 18px;
  box-shadow: 0 18px 45px rgba(15, 23, 42, 0.12);
  text-align: left;
  padding: 24px 32px 40px;
  box-sizing: border-box;
}

/* Header */
.thrColElsHdr #header {
  padding: 8px 0 18px;
  border-bottom: 1px solid #e5e7eb;
  margin-bottom: 24px;
}

.thrColElsHdr #header table {
  width: 100%;
  border-collapse: collapse;
}

.thrColElsHdr #header td {
  vertical-align: middle;
}

.thrColElsHdr #header u {
  text-decoration: none;
  font-size: 2.4rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: #111827;
font-family: "Montserrat", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.thrColElsHdr #header img {
  display: block;
}

/* Top-right Unife logo slightly smaller */
.thrColElsHdr #header img[src$="logo.png"] {
  width: 280px;
  height: 69px;
}

#sidebar2 img[src$="logo_unife.png"]{
  width: 110px !important;   /* o 90, 120… */
  height: 110px !important;
}

#sidebar2 img[src$="indam_logo.png"] {
  width: 110px !important;   /* o 90, 120… */
  height: 30px !important;
}

/* Side logos slightly smaller */
.thrColElsHdr #sidebar1 img[src$="logo_unife.png"],
.thrColElsHdr #sidebar1 img[src$="indam_logo.png"] {
  max-width: 115px;
  height: auto;
}

/* Columns */
.thrColElsHdr #sidebar1,
.thrColElsHdr #sidebar2 {
  float: left;
  width: 180px; /* narrower side stripes */
  background: transparent;
  padding: 8px 0 0;
}

.thrColElsHdr #sidebar2 {
  float: right;
}

.thrColElsHdr #mainContent {
  margin: 0 200px 0 200px; /* central band wider */
  padding-top: 4px;
}

/* Sidebar typography */
.style2 {
  font-size: 0.92rem;
  color: #374151;
}

.style4 {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #6b7280;
}

/* General typography */
h1, h2, h3, h4 {
font-family: "Montserrat", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #111827;
  letter-spacing: 0.02em;
}

h2 {
  font-size: 1.55rem;
  margin-top: 0;
  margin-bottom: 0.75rem;
}

p {
  margin-top: 0.35rem;
  margin-bottom: 0.35rem;
}

/* Links: dark red like the header text */
a {
  color: #940204;
  text-decoration: none;
}

a:hover {
  color: #5b0203;
  text-decoration: underline;
}

/* Sidebar links */
#sidebar1 a,
#sidebar2 a {
  display: inline-block;
  padding: 2px 0;
}

/* Contact block on the home page a bit smaller */
.contact-block {
  font-size: 0.9rem;
  color: #4b5563;
  line-height: 1.6;
  text-align: left;
}

/* Tables in content */
#mainContent table {
  border-collapse: collapse;
  width: 100%;
}

#mainContent td,
#mainContent th {
  padding: 4px 6px;
  vertical-align: top;
}

/* Images in main content */
#mainContent img {
  max-width: 100%;
  height: auto;
  display: block;
  margin: 8px auto;
}

/* Specific adjustment: central image on Computer Algebra page */
#mainContent img[src$="Mag_Fer.png"] {
  max-width: 70%;
}

/* Footer */
.thrColElsHdr #footer {
	clear: both;  
  padding-top: 8px;
  margin-top: 8px;
  border-top: 1px solid #e5e7eb;
  font-size: 0.78rem;
  color: #6b7280;
  text-align: center;
}

.thrColElsHdr #footer table {
  width: 100%;
  max-width: 100%;
  margin: 0 auto;
}

.thrColElsHdr #footer td {
  white-space: nowrap; /* keep “A. M. - HOME PAGE” and “DMI - UNIFE” on one line each */
  padding: 0 8px;
}

/* Responsive tweaks */
@media (max-width: 1024px) {
  .thrColElsHdr #container {
    margin: 16px auto 24px;
    padding: 20px 18px 28px;
  }

  .thrColElsHdr #sidebar1,
  .thrColElsHdr #sidebar2 {
    width: 170px;
  }

  .thrColElsHdr #mainContent {
    margin: 0 190px 0 190px;
  }
}

@media (max-width: 900px) {
  .thrColElsHdr #sidebar1,
  .thrColElsHdr #sidebar2 {
    float: none;
    width: auto;
    margin-top: 24px;
  }

  .thrColElsHdr #mainContent {
    margin: 0;
  }
}

@media (max-width: 640px) {
  .thrColElsHdr #header u {
    font-size: 1.7rem;
  }

  .thrColElsHdr #header img[src$="logo.png"] {
    width: 220px;
  }
}

.style9 {
font-family: "Montserrat", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: small;
  text-align: center;
}

body, td, th {
  font-family: 'Montserrat', sans-serif;
}

</style><!--[if IE]>
